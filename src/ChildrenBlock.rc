#include "resource.h"
#include "afxres.h"

#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

// 아이콘은 tools\make-icons.ps1 로 생성
IDR_MAINFRAME           ICON    "res\\ChildrenBlock.ico"
IDI_TRAY_BREAKSOON      ICON    "res\\TrayBreakSoon.ico"
IDI_TRAY_BREAK          ICON    "res\\TrayBreak.ico"
IDI_TRAY_SHUTDOWN       ICON    "res\\TrayShutdown.ico"

IDD_PASSWORD DIALOGEX 0, 0, 230, 86
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ChildrenBlock - 비밀번호"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "비밀번호를 입력하세요.", IDC_PROMPT, 10, 10, 210, 20
    EDITTEXT        IDC_PASSWORD, 10, 34, 210, 14, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "확인", IDOK, 114, 60, 50, 16
    PUSHBUTTON      "취소", IDCANCEL, 170, 60, 50, 16
END

IDD_SETUP_PASSWORD DIALOGEX 0, 0, 230, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ChildrenBlock - 비밀번호 등록"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "새 비밀번호를 입력하세요.", IDC_PROMPT, 10, 10, 210, 24
    LTEXT           "비밀번호", IDC_STATIC, 10, 42, 60, 10
    EDITTEXT        IDC_PASSWORD, 75, 40, 145, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "비밀번호 확인", IDC_STATIC, 10, 62, 60, 10
    EDITTEXT        IDC_PASSWORD2, 75, 60, 145, 14, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "등록", IDOK, 114, 94, 50, 16
    PUSHBUTTON      "취소", IDCANCEL, 170, 94, 50, 16
END

IDD_SETTINGS DIALOGEX 0, 0, 262, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ChildrenBlock - 설정"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX        "사용 / 휴식 주기", IDC_STATIC, 7, 7, 248, 92
    CONTROL         "휴식 시간 사용", IDC_BREAK_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 20, 120, 10
    LTEXT           "사용 시간 (분)", IDC_STATIC, 15, 37, 100, 10
    EDITTEXT        IDC_USE_MIN, 125, 35, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "5 ~ 180", IDC_STATIC, 172, 37, 70, 10
    LTEXT           "휴식 시간 (분)", IDC_STATIC, 15, 54, 100, 10
    EDITTEXT        IDC_BREAK_MIN, 125, 52, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "1 ~ 60", IDC_STATIC, 172, 54, 70, 10
    LTEXT           "휴식 전 알림 (초)", IDC_STATIC, 15, 71, 100, 10
    EDITTEXT        IDC_BREAK_WARN_SEC, 125, 69, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "0 ~ 300", IDC_STATIC, 172, 71, 70, 10
    CONTROL         "휴식 시간도 하루 사용 시간에 포함", IDC_COUNT_BREAK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 85, 200, 10

    GROUPBOX        "자동 종료", IDC_STATIC, 7, 105, 248, 82
    CONTROL         "하루 사용 시간 제한 (분)", IDC_LIMIT_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 120, 105, 10
    EDITTEXT        IDC_LIMIT_MIN, 125, 118, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "10 ~ 720", IDC_STATIC, 172, 120, 70, 10
    CONTROL         "종료 시각", IDC_SHUTAT_ENABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 138, 105, 10
    CONTROL         "", IDC_SHUTAT_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 125, 136, 55, 13
    LTEXT           "종료 전 알림 (분)", IDC_STATIC, 15, 156, 100, 10
    EDITTEXT        IDC_SHUT_WARN_MIN, 125, 154, 40, 13, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "1 ~ 10", IDC_STATIC, 172, 156, 70, 10
    LTEXT           "둘 다 켜면 먼저 도달하는 쪽에서 종료합니다.", IDC_STATIC, 15, 172, 230, 10

    LTEXT           "오늘 사용한 시간:", IDC_USED_TODAY, 10, 196, 240, 10
    PUSHBUTTON      "사용 기록...", IDC_SHOW_HISTORY, 7, 214, 60, 16
    DEFPUSHBUTTON   "저장", IDOK, 148, 214, 50, 16
    PUSHBUTTON      "취소", IDCANCEL, 205, 214, 50, 16
END

IDD_HISTORY DIALOGEX 0, 0, 300, 292
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "ChildrenBlock - 사용 기록"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "최근 14일", IDC_HISTORY_TITLE, 10, 10, 170, 10
    COMBOBOX        IDC_HISTORY_USER, 190, 7, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_HISTORY_CHART, "Static", SS_WHITERECT, 10, 24, 280, 112
    LTEXT           "", IDC_HISTORY_SUMMARY, 10, 144, 280, 10
    CONTROL         "", IDC_HISTORY_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 160, 280, 102
    DEFPUSHBUTTON   "닫기", IDOK, 240, 270, 50, 16
END
